# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
#   nano .env

# Your website address. Use :80 first (works with the server's IP address).
# After you have a free name from duckdns.org, write it here, e.g. eusleats.duckdns.org
DOMAIN=:80

# Ports on THIS computer. On your own PC, XAMPP/Apache may already use 80 and 443;
# then use these instead and open http://localhost:8081
HTTP_PORT=80
HTTPS_PORT=443

# Make these long and different. Create one with:  openssl rand -hex 24
DB_ROOT_PASSWORD=change-me-root-password
DB_PASSWORD=change-me-database-password
APP_SECRET=change-me-a-long-random-secret-at-least-32-characters

# The first admin account (created automatically the first time).
ADMIN_EMAIL=admin@eusl.lk
ADMIN_PASSWORD=change-me-admin-password

# Database program. Use the same kind you use on your PC:
DB_IMAGE=mysql:8.4

# Text messages to stores. "log" only writes to the log (nothing is sent).
SMS_PROVIDER=log
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=NotifyDEMO
